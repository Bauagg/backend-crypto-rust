# Konfigurasi untuk `docker compose`. Salin jadi `.env.docker` lalu isi nilai rahasianya.
# Host database & redis = nama service di docker-compose.yml (`postgres`, `redis`), BUKAN localhost.

# ---- Postgres (dipakai container postgres saat pertama kali dibuat) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_password_db
POSTGRES_DB=treding_rust

# ---- Redis ----
REDIS_PASSWORD=ganti_password_redis

# ---- Backend Rust ----
# Karakter khusus di password wajib di-encode di URL (mis. @ -> %40).
DATABASE_URL=postgres://postgres:ganti_password_db@postgres:5432/treding_rust
REDIS_URL=redis://:ganti_password_redis@redis:6379

PORT=8000
RUST_LOG=info
PATH_FILE_UPLOAD=files
# URL publik backend (domain Cloudflare) — dipakai untuk membentuk URL foto yang disimpan.
BASE_URL=https://api.domainmu.com

JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti_dengan_string_acak_panjang_lain
JWT_REFRESH_EXPIRES_IN=7d

# 32 karakter, untuk enkripsi API key/secret exchange. JANGAN diganti setelah ada user yang
# menyimpan API key — key yang tersimpan tidak bisa dibaca lagi.
ENCRYPTION_KEY=ganti_dengan_32_karakter_acak____

MARKET_API_BASE_URL=https://api.binance.com
MARKET_WS_BASE_URL=wss://stream.binance.com:9443/ws
# Exchange untuk order robot live: aktifkan SALAH SATU.
ACCOUNT_API_BASE_URL=https://testnet.binance.vision
# ACCOUNT_API_BASE_URL=https://api.binance.com

# API strategi Python. Kalau container Python ikut network `treding-net`, pakai nama service-nya;
# kalau Python jalan langsung di host VPS: http://host.docker.internal:8080 (Linux: tambahkan
# extra_hosts "host.docker.internal:host-gateway" di service backend).
STRATEGY_API_BASE_URL=http://strategy-api:8080
# Dikirim sebagai header X-API-Key ke setiap request API Python (harus sama dengan key di Python).
STRATEGY_API_KEY=ganti_dengan_api_key_python

# ---- AI (asisten penyusun strategi screener) ----
# 9router, API format OpenAI (/v1/chat/completions). Base URL termasuk /v1.
# AI_ROUTER_MODEL = nama combo di dashboard 9router — model & urutan fallback diatur di 9router.
# API key dari menu Endpoint & Key 9router.
AI_ROUTER_BASE_URL=https://9router.athenastudio.my.id/v1
AI_ROUTER_API_KEY=ganti_dengan_api_key_9router
AI_ROUTER_MODEL=AI-Crypro

COINGECKO_API_URL=https://api.coingecko.com/api/v3
FNG_API_URL=https://api.alternative.me/fng/

# ---- Email (SMTP) ----
# Gmail: SMTP_PASSWORD = App Password Google (16 huruf, tanpa spasi), BUKAN password Gmail.
# Buat di: https://myaccount.google.com/apppasswords (Verifikasi 2 Langkah wajib aktif dulu:
# https://myaccount.google.com/signinoptions/twosv). Buat terpisah untuk tiap server (dev/prod)
# supaya bisa dicabut sendiri-sendiri.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=emailanda@gmail.com
SMTP_PASSWORD=ganti_dengan_app_password
SMTP_FROM_NAME=Algo Bot PRO
SMTP_FROM_EMAIL=emailanda@gmail.com
