DATABASE_URL=postgres://postgres:password@localhost:5432/backend_trading
REDIS_URL=redis://127.0.0.1:6379

PATH_FILE_UPLOAD=files
BASE_URL=http://localhost:3000

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# harus 32 karakter, dipakai utk enkripsi AES-256-GCM api_secret exchange
ENCRYPTION_KEY=change_this_to_a_random_32_char_key

# Binance jadi sumber utama (Kominfo sempat blokir tapi saat ini bisa diakses). Kalau Binance
# diblokir lagi, ganti dua baris di bawah ini ke pasangan Tokocrypto (lihat komentar fallback):
# MARKET_API_BASE_URL=https://www.tokocrypto.site
# MARKET_WS_BASE_URL=wss://stream-cloud.tokocrypto.site/ws
MARKET_API_BASE_URL=https://api.binance.com
MARKET_WS_BASE_URL=wss://stream.binance.com:9443/ws

# API strategi ML (backtes-crypto, Python/FastAPI)
STRATEGY_API_BASE_URL=http://localhost:8080
# Dikirim sebagai header X-API-Key ke setiap request API Python. Kosong = tanpa header.
STRATEGY_API_KEY=

# AI (asisten penyusun strategi screener) lewat 9router — API format OpenAI (/v1/chat/completions).
# Base URL termasuk /v1. AI_ROUTER_MODEL = nama combo di dashboard 9router (Combo & Vision Adapter);
# model & urutan fallback-nya diatur di 9router, bukan di kode. API key dari menu Endpoint & Key.
AI_ROUTER_BASE_URL=https://9router.athenastudio.my.id/v1
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=AI-Crypro

# CoinGecko — market cap (kategori Large/Mid/Small) & logo coin (sync coin symbols harian)
COINGECKO_API_URL=https://api.coingecko.com/api/v3


# Sumber Fear & Greed Index (sentimen pasar), dipakai fitur input model ML
FNG_API_URL=https://api.alternative.me/fng/

PORT=3000
RUST_LOG=info

# Gmail SMTP untuk kirim email (mis. reset password). SMTP_PASSWORD = App Password Google
# (16 huruf, tanpa spasi) dari https://myaccount.google.com/apppasswords — BUKAN password Gmail.
# Wajib Verifikasi 2 Langkah aktif dulu (https://myaccount.google.com/signinoptions/twosv).
# Gmail pribadi dibatasi ±500 email/hari.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=emailanda@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Algo Bot PRO
SMTP_FROM_EMAIL=emailanda@gmail.com
