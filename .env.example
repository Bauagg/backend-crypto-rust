DATABASE_URL=postgres://postgres:password@localhost:5432/backend_trading
REDIS_URL=redis://127.0.0.1:6379

PATH_FILE_UPLOAD=files
BASE_URL=http://localhost:3000

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# harus 32 karakter, dipakai utk enkripsi AES-256-GCM api_secret exchange
ENCRYPTION_KEY=change_this_to_a_random_32_char_key

# Binance jadi sumber utama (Kominfo sempat blokir tapi saat ini bisa diakses). Kalau Binance
# diblokir lagi, ganti dua baris di bawah ini ke pasangan Tokocrypto (lihat komentar fallback):
# MARKET_API_BASE_URL=https://www.tokocrypto.site
# MARKET_WS_BASE_URL=wss://stream-cloud.tokocrypto.site/ws
MARKET_API_BASE_URL=https://api.binance.com
MARKET_WS_BASE_URL=wss://stream.binance.com:9443/ws

# API strategi ML (backtes-crypto, Python/FastAPI)
STRATEGY_API_BASE_URL=http://localhost:8080

# CoinGecko — market cap (kategori Large/Mid/Small) & logo coin (sync coin symbols harian)
COINGECKO_API_URL=https://api.coingecko.com/api/v3


# Sumber Fear & Greed Index (sentimen pasar), dipakai fitur input model ML
FNG_API_URL=https://api.alternative.me/fng/

PORT=3000
RUST_LOG=info
